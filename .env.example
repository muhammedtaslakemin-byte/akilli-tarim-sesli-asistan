# ==============================================================
# Akıllı Tarım Sesli Asistanı - Çevre Değişkenleri Şablonu
# Bu dosyayı '.env' olarak kopyalayın ve kendi bilgilerinizi girin.
# ==============================================================

# Google Gemini API Anahtarınız (https://aistudio.google.com/ adresinden ücretsiz alınabilir)
GEMINI_API_KEY=your_gemini_api_key_here

# Kullanılacak Gemini Modeli (Örn: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# FastAPI Sunucu Yapılandırması
HOST=127.0.0.1
PORT=8000

# Varsayılan Çiftçi ID (Test ve kimlik doğrulama için)
DEFAULT_FARMER_ID=205

# Canlı Hava Durumu Konumu (Open-Meteo koordinatları)
WEATHER_CITY=Şanlıurfa
WEATHER_LATITUDE=37.16
WEATHER_LONGITUDE=38.79
